{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.healthyome.com/api/shop",
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.healthyome.com/api/shop",
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.healthyome.com/api/shop",
        "EXPO_PUBLIC_APP_ENV": "preview"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "com.healthyome.app"
      },
      "android": {
        "package": "com.healthyome.app"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.healthyome.com/api/shop",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
