{
  "expo": {
    "name": "Healthy-O-Me",
    "slug": "healthyome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "healthyome",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFFF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthyome.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow HealthyOme to access your camera for profile photos",
        "NSPhotoLibraryUsageDescription": "Allow HealthyOme to access your photos for profile photos",
        "NSLocationWhenInUseUsageDescription": "Allow HealthyOme to use your location to find delivery areas near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FAFFF8"
      },
      "package": "com.healthyome.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HealthyOme to use your location to find delivery areas near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFFF8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-notifications",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "https://healthyome.in/api/shop",
      "appEnv": "production",
      "readOnlyPreview": true
    }
  }
}
