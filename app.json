{
  "expo": {
    "name": "Healthy-O-Me",
    "slug": "healthyome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "healthyome",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFFF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthyome.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow HealthyOme to access your camera for profile photos",
        "NSPhotoLibraryUsageDescription": "Allow HealthyOme to access your photos for profile photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFFF8"
      },
      "package": "com.healthyome.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFFF8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "healthyome-mobile"
      }
    }
  }
}
